# Never put real values in this file. Configure these as Supabase Edge Function secrets.

WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_ACCESS_TOKEN=your-whatsapp-cloud-api-access-token
ALLOWED_WHATSAPP_NUMBER=15551234567
META_GRAPH_VERSION=v23.0

# Native glasses requests use OpenAI through the Responses API.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-terra

# WhatsApp requests still use Gemini.
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
